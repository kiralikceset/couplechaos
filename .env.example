# ── Mobile app build (baked into the APK/IPA at build time) ──
# Public HTTPS address of YOUR deployed game server (see server/ and Dockerfile)
VITE_GAME_SERVER_URL=https://your-game-server.example.com
# Sign in with Google (Google Cloud Console → Credentials). Leave empty to hide the Google button.
VITE_GOOGLE_WEB_CLIENT_ID=
VITE_GOOGLE_IOS_CLIENT_ID=

# ── Game server (set these on the hosting provider, NOT in the app) ──
# Pick one AI provider. Leave both empty to use the offline comments.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Free options: Google Gemini (aistudio.google.com/apikey) or Groq (console.groq.com/keys)
GEMINI_API_KEY=
GROQ_API_KEY=
# Sign-in verification: the same client IDs as above, comma-separated
GOOGLE_CLIENT_IDS=
# APPLE_BUNDLE_IDS=com.couplechaos.app
# AI_PROVIDER=auto          # auto | anthropic | openai | gemini | groq
# AI_MODEL=                 # optional override
# AI_TIMEOUT_MS=7000
# AI_DAILY_LIMIT=3000       # cost guard: max AI judgements per day
# DESCRIBE_SECONDS=10
# DRAW_SECONDS=10
# CO_DRAW_SECONDS=20       # Ortak Tuval round length
# PORT=3000
